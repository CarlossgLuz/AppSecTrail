---
import Base from '../../layouts/Base.astro';
import GuidedTrail from '../../components/GuidedTrail';
import { getCollection } from 'astro:content';
const order = ['http-essencial', 'appsec-cookies-sessao-01', 'appsec-autorizacao-objetos-01'];
const entries = await getCollection('modules', ({ id, data }) => order.includes(id) && !data.draft);
const modules = order.flatMap(id => {
  const match = entries.find(entry => entry.id === id);
  return match ? [{ id: match.id, title: match.data.title, summary: match.data.summary }] : [];
});
---
<Base title="Trilhas">
  <header class="lesson-header-card">
    <h1>Primeiros passos em segurança web</h1>
    <p class="lead">Entenda HTTP, proteja sessões e aprenda a decidir quem pode acessar cada recurso. Três aulas em sequência — sem bloquear o acesso às demais.</p>
  </header>
  <GuidedTrail client:load modules={modules} />
</Base>
