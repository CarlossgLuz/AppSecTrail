---
import { sitePath } from '../../lib/paths';
import Base from '../../layouts/Base.astro';
import Exercise from '../../components/Exercise';
import LessonHistory from '../../components/LessonHistory';
import DidacticDiagram from '../../components/DidacticDiagram';
import { getCollection, render } from 'astro:content';

export async function getStaticPaths() {
  const entries = await getCollection('modules', ({ data }) => !data.draft);
  return entries.map(entry => ({ params: { id: entry.id }, props: { entry } }));
}

const { entry } = Astro.props;
const { Content, headings } = await render(entry);
const tocHeadings = headings.filter(h => h.depth === 2);
const catNorm = entry.data.category.toLowerCase();
const catBadge = catNorm.includes('appsec')
  ? 'badge badge-appsec'
  : catNorm.includes('devsecops')
    ? 'badge badge-devsecops'
    : 'badge badge-fundamentos';
---
<Base title={entry.data.title} description={entry.data.summary}>
  <div class="breadcrumb-bar">
    <a class="breadcrumb-link" href={sitePath('/biblioteca/')}>← Biblioteca</a>
    <a class="breadcrumb-link" href={sitePath('/trilhas/')}>Percurso guiado</a>
  </div>

  <header class="lesson-header-card">
    <div class="lesson-meta-pills">
      <p class="eyebrow" style="margin-bottom: 0;">{entry.data.category}</p>
      {entry.data.competencyIds.map((comp: string) => (
        <span class={catBadge}>Competência {comp}</span>
      ))}
      <span class="badge badge-neutral">Versão {entry.data.version}</span>
      <span class="badge badge-neutral">Licença {entry.data.license}</span>
    </div>
    <h1>{entry.data.title}</h1>
    <p class="lead" style="margin-bottom: 0;">{entry.data.summary}</p>
  </header>

  <div class="lesson-layout">
    <div>
      <DidacticDiagram lessonId={entry.id} category={entry.data.category} />

      <article class="lesson-prose">
        <Content />
      </article>

      {entry.data.exercise && (
        <Exercise
          client:load
          {...entry.data.exercise}
          moduleId={entry.id}
          moduleVersion={entry.data.version}
        />
      )}

      <LessonHistory
        client:load
        lessonId={entry.id}
        lessonVersion={entry.data.version}
      />
    </div>

    <aside class="lesson-sidebar" aria-label="Resumo e navegação da aula">
      <div class="sidebar-box">
        <h2>Objetivos de aprendizagem</h2>
        <ul class="sidebar-list">
          {entry.data.learningObjectives.map((obj: string) => (
            <li>{obj}</li>
          ))}
        </ul>
      </div>

      {entry.data.editorial?.prerequisites && entry.data.editorial.prerequisites.length > 0 && (
        <div class="sidebar-box">
          <h2>Pré-requisitos recomendados</h2>
          <ul class="sidebar-list">
            {entry.data.editorial.prerequisites.map((pre: string) => (
              <li>{pre}</li>
            ))}
          </ul>
        </div>
      )}

      {tocHeadings.length > 0 && (
        <div class="sidebar-box">
          <h2>Nesta aula</h2>
          <ul class="sidebar-list" style="list-style: none; padding-left: 0;">
            {tocHeadings.map(h => (
              <li>
                <a href={`#${h.slug}`} style="text-decoration: none;">{h.text}</a>
              </li>
            ))}
            {entry.data.exercise && (
              <li>
                <a href="#exercise-title" style="text-decoration: none; font-weight: 700;">
                  → Exercício prático
                </a>
              </li>
            )}
          </ul>
        </div>
      )}

      <div class="sidebar-box">
        <h2>Revisão e autoria</h2>
        <p style="font-size: 0.86rem; margin: 0;">
          Autoria: <strong>{entry.data.author}</strong><br />
          Revisão técnica: <strong>{entry.data.lastTechnicalReview}</strong>
        </p>
      </div>
    </aside>
  </div>
</Base>
