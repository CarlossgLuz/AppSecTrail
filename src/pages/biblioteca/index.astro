---
import Base from '../../layouts/Base.astro';
import { sitePath } from '../../lib/paths';
import Catalog from '../../components/Catalog';
import { getCollection } from 'astro:content';
const entries = await getCollection('modules', ({ data }) => !data.draft);
const modules = entries.map(({ id, data }) => ({ id, title: data.title, category: data.category, summary: data.summary }));
---
<Base title="Biblioteca">
  <header style="margin-bottom: 1.5rem;">
    <h1>Biblioteca</h1>
    <p class="lead">Escolha um assunto e comece. Todas as aulas têm acesso livre.</p>
    <a class="minimal-inline-link" href={sitePath('/trilhas/')}>Prefere uma sequência? Veja a trilha guiada →</a>
  </header>
  <Catalog client:load modules={modules} />
</Base>
