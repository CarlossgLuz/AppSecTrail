---
import Base from '../../layouts/Base.astro';
import Catalog from '../../components/Catalog';
import { getCollection } from 'astro:content';
const entries = await getCollection('modules', ({ data }) => !data.draft);
const modules = entries.map(({ id, data }) => ({ id, title: data.title, category: data.category, summary: data.summary }));
---
<Base title="Biblioteca">
  <header style="margin-bottom: 1.5rem;">
    <p class="eyebrow">Conteúdo livre</p>
    <h1>Explore a biblioteca.</h1>
    <p class="lead">
      Encontre um assunto e estude na ordem que fizer sentido para você. Cada módulo combina explicação direta, exemplo seguro e verificação prática.
    </p>
  </header>
  <Catalog client:load modules={modules} />
</Base>
